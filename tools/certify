#!/bin/sh
# Parity certificate: run the cross-language cases in R, Python and Stata.
#   sh tools/certify             run them, and Stata's own suites; PASS / FAIL per case
#   sh tools/certify --record    if all pass, write and commit .parity/<hash>.json
#   sh tools/certify --verify    check a passing certificate is committed (runs nothing)
#   sh tools/certify --verify --rev <commit>   the same, for another commit
#   sh tools/certify --lint      check the case files and the suites' last lines (runs nothing)
# CSO_PYTHON: a Python with the toolkit's dependencies for the Python driver.
# CSO_RSCRIPT / STATA_EXE: override where R and Stata are found.
# See conformance/README.md (#190).
cd "$(git rev-parse --show-toplevel)" || exit 1
for p in "$CSO_PYTHON" python3 python; do
  [ -n "$p" ] && "$p" -c "import sys" >/dev/null 2>&1 && exec "$p" conformance/certify.py "$@"
done
if py -3 -c "import sys" >/dev/null 2>&1; then exec py -3 conformance/certify.py "$@"; fi
echo "tools/certify: no Python found; set CSO_PYTHON." >&2
exit 1
