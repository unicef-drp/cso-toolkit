#!/bin/sh
# ---------------------------------------------------------------------------
# pre-push -- refuse a push whose content has no passing check record
# ---------------------------------------------------------------------------
# Template from unicef-drp/cso-toolkit: templates/hooks/pre-push
# Guidance: docs/ci_cd_guidelines.md; handbook chapter "Checks and CI" ("Check records").
#
# Install (once per clone; the hook is tracked):
#   git config core.hooksPath .githooks
#
# Make a record before pushing:
#   sh tools/check --record    # runs the checks; if all pass, commits
#                              # .checks/<content-hash>.json
#
# MODE (the setting below; CHECK_HOOK_MODE overrides it for one push):
#   verify  (default) for each pushed branch, require a passing record for
#           the commit's content, committed in that commit. Runs no R, so
#           pushes stay fast. The check-record workflow verifies the same
#           record on pull requests.
#   run     run tools/check.R instead, as before check records: for
#           repositories that do not use records.
#
# Skip once, when you must (say so in the pull request; the pull request's
# check-record status still fails without a record):
#   git push --no-verify          or   CHECK_SKIP=1 git push
# In run mode: a subset with CHECK_ARGS="--skip tests" git push; Rscript not
# on the PATH (common on Windows)? Set RSCRIPT.
# ---------------------------------------------------------------------------

MODE=verify

MODE="${CHECK_HOOK_MODE:-$MODE}"
if [ -n "$CHECK_SKIP" ]; then
  echo "pre-push: CHECK_SKIP is set; no check." >&2
  exit 0
fi
root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1

case "$MODE" in
  verify)
    # The content hash is git's tree ID of the commit with .checks/ left
    # out; the record must be in the pushed commit and say "result": "pass".
    TAB=$(printf '\t')
    ZERO=0000000000000000000000000000000000000000
    status=0
    while read -r local_ref local_sha remote_ref remote_sha; do
      [ "$local_sha" = "$ZERO" ] && continue                 # branch deletion
      case "$local_ref" in refs/tags/*) continue ;; esac     # tags
      hash=$(git ls-tree "$local_sha" | grep -v "${TAB}\.checks\$" | git mktree)
      rec=".checks/$hash.json"
      if git cat-file -e "$local_sha:$rec" 2>/dev/null &&
         git show "$local_sha:$rec" | grep -q '"result": *"pass"'; then
        echo "pre-push: $local_ref has a passing check record ($rec)" >&2
      else
        echo "pre-push: $local_ref ($(git rev-parse --short "$local_sha")) has no passing check record for its content." >&2
        echo "          Run:  sh tools/check --record   then push again." >&2
        status=1
      fi
    done
    exit $status
    ;;
  run)
    if [ ! -f tools/check.R ]; then
      echo "pre-push: tools/check.R not found; copy it from cso-toolkit templates/tools/." >&2
      exit 1
    fi
    if [ -f tools/check ]; then
      echo "pre-push: running tools/check (skip once with git push --no-verify)" >&2
      # shellcheck disable=SC2086  # CHECK_ARGS is split into words on purpose
      sh tools/check $CHECK_ARGS
    else
      rs="${RSCRIPT:-}"
      if [ -z "$rs" ]; then
        if command -v Rscript > /dev/null 2>&1; then
          rs=Rscript
        else
          for cand in "/c/Program Files/R"/R-*/bin/Rscript.exe; do
            [ -f "$cand" ] && rs="$cand"
          done
        fi
      fi
      if [ -z "$rs" ]; then
        echo "pre-push: Rscript not found. Set RSCRIPT to its path, or put R on the PATH." >&2
        exit 1
      fi
      echo "pre-push: running tools/check.R (skip once with git push --no-verify)" >&2
      # shellcheck disable=SC2086
      "$rs" --no-init-file tools/check.R $CHECK_ARGS
    fi
    status=$?
    if [ $status -ne 0 ]; then
      echo "pre-push: checks failed; push stopped. Fix them, or push with --no-verify and say why in the PR." >&2
    fi
    exit $status
    ;;
  *)
    echo "pre-push: MODE must be verify or run, not '$MODE' (set at the top of .githooks/pre-push)." >&2
    exit 1
    ;;
esac
